# Copy this file to .envrc.local, which git ignores, and fill in your values.
# Neither value is a secret. They stay out of the repo so the repo is not tied to one account.

# The 12-digit AWS account ID. The stacks refuse every other account.
export TF_VAR_account_id=000000000000

# The AWS SSO profile of a human who can create IAM roles. It applies stacks/iam.
export BENCH_BOOTSTRAP_PROFILE=your-sso-profile

# The role profile that stacks/base and the harness use. The runbook shows how to add it.
# export AWS_PROFILE=baskingspot-bench
