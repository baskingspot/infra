# NixOS configuration for every box of the fleet, rendered by the bench-base
# module into the launch template user_data.
#
# This file is a templatefile() template: a literal dollar-brace or
# percent-brace must be doubled ($${ or %%{).
#
# On boot, the amazon-init service of the official NixOS AMI copies the
# rendered file to /etc/nixos/configuration.nix and runs `nixos-rebuild
# switch` against the channel that the AMI ships. The file must evaluate
# against that channel (nixos-25.11 for the pinned AMIs), not against any
# flake. amazon-init reads a line that starts with three hash signs as a
# channel URL, and a file that starts with #! as a shell script. Avoid both.
#
# The module owns the fleet contract: the TTL guard, SSH through SSM and EC2
# Instance Connect, nix-ld for shipped binaries, benchmark sysctls, and
# /etc/bench-image. The project adds its own settings through
# var.nixos_module, imported below.
{ pkgs, lib, ... }:
let
  # TTL guard: power off after the ExpiresAt instance tag, or after the
  # maximum lifetime, whichever comes first. The launch template sets
  # shutdown behavior to terminate, so poweroff destroys the instance. The
  # maximum lifetime does not read the tag, so a tag far in the future does
  # not keep a box alive. It counts from boot: a reboot restarts it, and the
  # reaper, which counts from LaunchTime, covers that case.
  ttlGuard = ''
    set -u
    imds=http://169.254.169.254/latest
    state=/run/bench-ttl-guard
    fallback_seconds=$((12 * 3600))
    max_lifetime_seconds=$((${max_lifetime_hours} * 3600))

    now=$(date -u +%s)
    uptime=$(cut -d. -f1 /proc/uptime)
    expires=""

    if [ "$uptime" -ge "$max_lifetime_seconds" ]; then
      echo "Uptime $uptime s reached the maximum lifetime of ${max_lifetime_hours} hours; powering off"
      poweroff
      exit 0
    fi

    # IMDSv2: get a session token, then read the tag. curl prints 000 as the
    # HTTP code when it cannot connect.
    code=000
    if token=$(curl -sf -m 2 -X PUT \
      -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' "$imds/api/token"); then
      code=$(curl -s -m 2 -o "$state/tag" -w '%%{http_code}' \
        -H "X-aws-ec2-metadata-token: $token" \
        "$imds/meta-data/tags/instance/ExpiresAt") || true
    fi

    case $code in
      200)
        # The tag is RFC 3339 UTC, for example 2026-09-24T04:00:00Z. Check the
        # shape first: `date -d` also accepts "" and words like "tomorrow".
        value=$(cat "$state/tag")
        rfc3339='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
        if [[ $value =~ $rfc3339 ]] && expires=$(date -u -d "$value" +%s); then
          echo "$expires" >"$state/expires-at"
        else
          echo "ExpiresAt tag '$value' is not an RFC 3339 UTC time; using the fallback"
          expires=""
          rm -f "$state/expires-at"
        fi
        ;;
      404)
        # No ExpiresAt tag, or instance metadata tags are off.
        rm -f "$state/expires-at"
        ;;
      *)
        # IMDS did not answer. Keep the last value that it gave, so that a
        # short IMDS fault does not stop a box that has a long TTL.
        echo "IMDS read failed (HTTP $code)"
        if [ -s "$state/expires-at" ]; then
          expires=$(cat "$state/expires-at")
        fi
        ;;
    esac

    if [ -z "$expires" ]; then
      expires=$((now - uptime + fallback_seconds))
    fi

    if [ "$now" -ge "$expires" ]; then
      echo "TTL expired at $(date -u -d "@$expires" +%Y-%m-%dT%H:%M:%SZ); powering off"
      poweroff
    fi
  '';

  # EC2 Instance Connect: the AuthorizedKeysCommand that AWS ships for Amazon
  # Linux and Ubuntu. nixpkgs has no package for it. A person or agent pushes
  # a public key with ec2-instance-connect:SendSSHPublicKey, IMDS serves it
  # for 60 seconds, and these scripts check the AWS signature and the OCSP
  # staples before they give the key to sshd. The box holds no long-lived key.
  #
  # The scripts call /bin and /usr/bin by absolute path. The install step
  # removes those prefixes and the wrapper supplies PATH. The CA path becomes
  # the bundle file: NixOS /etc/ssl/certs has no hashed links, and the parser
  # supports a bundle file.
  ec2InstanceConnect = pkgs.stdenvNoCC.mkDerivation {
    pname = "ec2-instance-connect";
    version = "1.1-18";
    src = pkgs.fetchFromGitHub {
      owner = "aws";
      repo = "aws-ec2-instance-connect-config";
      rev = "551c73e8ec1f5ade4c8b1f52cf616e75b47879b4";
      hash = "sha256-zwHSIFGCgjtyvww4gIdF3jg+ECtULnR+27VgeH7KILY=";
    };
    nativeBuildInputs = [ pkgs.makeWrapper ];
    dontBuild = true;
    installPhase = ''
      install -Dm755 -t $out/bin src/bin/eic_run_authorized_keys \
        src/bin/eic_curl_authorized_keys src/bin/eic_parse_authorized_keys
      sed -i -E \
        -e '2,$ s#(^|[[:space:]"(=|`])/(usr/)?bin/#\1#g' \
        -e 's#^ca_path=/etc/ssl/certs$#ca_path=/etc/ssl/certs/ca-certificates.crt#' \
        $out/bin/*
      for script in $out/bin/*; do
        wrapProgram "$script" --prefix PATH : $${
          lib.makeBinPath (
            with pkgs;
            [
              coreutils
              curl
              findutils
              gawk
              gnugrep
              gnused
              openssh
              openssl
              util-linux
            ]
          )
        }
      done
    '';
  };
in
{
  imports = [
    <nixpkgs/nixos/modules/virtualisation/amazon-image.nix>
    # The project module (var.nixos_module).
    (
${nixos_module}
    )
  ];

  # The release of the pinned AMIs. It controls stateful defaults only.
  system.stateVersion = "25.11";

  nix.settings.experimental-features = [
    "nix-command"
    "flakes"
  ];
  nix.settings.download-buffer-size = 134217728;

  # The harness ships dynamically linked binaries that use the standard
  # interpreter paths (/lib64/ld-linux-x86-64.so.2, /lib/ld-linux-aarch64.so.1).
  programs.nix-ld.enable = true;

  # Disable ASLR for stable benchmark addresses and fewer page-table variations.
  boot.kernel.sysctl."kernel.randomize_va_space" = 0;
  boot.kernel.sysctl."kernel.perf_event_paranoid" = -1;
  boot.kernel.sysctl."kernel.kptr_restrict" = 0;

  # Mask services not needed during benchmarking to reduce timer interrupts
  # and background CPU noise. mkForce: the amazon-image module sets some of
  # these (serial-getty@ttyS0) at default priority, which conflicts with a
  # plain `false` — the eval fails and the first-boot rebuild never lands.
  # The amazon-ssm-agent service stays: SSH reaches the box only through an
  # SSM session. It runs in system.slice, which isolate() keeps off the
  # benchmark core.
  # NOTE: do NOT disable dhcpcd — it owns the interface on the EC2 image;
  # stopping it at the first-boot switch deconfigures the leased address and
  # the instance becomes unreachable seconds after boot. Its idle cost is
  # one renewal per hour; not worth losing the box.
  systemd.services.systemd-timesyncd.enable = lib.mkForce false;
  systemd.services.systemd-oomd.enable = lib.mkForce false;
  systemd.services."serial-getty@ttyS0".enable = lib.mkForce false;

  # The harness needs rsync for transfers and util-linux for lscpu (facts).
  environment.systemPackages = with pkgs; [
    rsync
    util-linux
  ];

  # SSH listens on the box, but the security group allows no inbound
  # traffic. The SSM agent connects the AWS-StartSSHSession tunnel to
  # localhost:22. The only keys are the ones that EC2 Instance Connect
  # pushed in the last 60 seconds. sshd refuses an AuthorizedKeysCommand
  # under /nix/store, which is group-writable, so a copy in /etc execs it.
  environment.etc."ssh/eic_run_authorized_keys" = {
    mode = "0755";
    text = ''
      #!/bin/sh
      exec $${ec2InstanceConnect}/bin/eic_run_authorized_keys "$@"
    '';
  };
  services.openssh.authorizedKeysCommand = "/etc/ssh/eic_run_authorized_keys %u %f";
  services.openssh.authorizedKeysCommandUser = "ec2-instance-connect";
  users.users.ec2-instance-connect = {
    isSystemUser = true;
    group = "ec2-instance-connect";
  };
  users.groups.ec2-instance-connect = { };

  environment.etc."bench-image".text = "${image_version}\n";

  systemd.services.bench-ttl-guard = {
    description = "Power off the box after its ExpiresAt tag";
    path = [ pkgs.curl ];
    script = ttlGuard;
    serviceConfig = {
      Type = "oneshot";
      RuntimeDirectory = "bench-ttl-guard";
      # Keep the last ExpiresAt value between runs of this oneshot service.
      RuntimeDirectoryPreserve = "yes";
    };
  };

  systemd.timers.bench-ttl-guard = {
    description = "Check the box TTL every minute";
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnCalendar = "minutely";
      AccuracySec = "5s";
    };
  };
}
